# BLOM Admin — environment variables
# Copy to `.env` and fill in real values. Never commit a filled-in copy.
#
# VITE_* variables are inlined into the browser bundle at build time and are
# PUBLIC. Everything else is read only by Netlify Functions on the server.

# ---------------------------------------------------------------------------
# Client (public)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
VITE_SPECIALS_WEBHOOK=https://your-n8n-host/webhook/specials
# Read by src/services/demoData.js (isDemoMode) — not currently wired into the app.
VITE_DEMO_MODE=false
# Legacy Base44 client (src/api/base44Client.js)
VITE_BASE44_APP_ID=your-base44-app-id
VITE_BASE44_BACKEND_URL=https://your-base44-backend

# ---------------------------------------------------------------------------
# Supabase (server-side)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Bypasses row-level security. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------------------------------------------------------------------------
# PayFast
# ---------------------------------------------------------------------------
PAYFAST_BASE=https://sandbox.payfast.co.za
PAYFAST_MERCHANT_ID=your-payfast-merchant-id
PAYFAST_MERCHANT_KEY=your-payfast-merchant-key
PAYFAST_PASSPHRASE=your-payfast-passphrase
PAYFAST_RETURN_URL=https://your-store.example/checkout/success
PAYFAST_CANCEL_URL=https://your-store.example/checkout/cancel
PAYFAST_NOTIFY_URL=https://your-store.example/.netlify/functions/payfast-itn

# ---------------------------------------------------------------------------
# n8n automation webhooks
# ---------------------------------------------------------------------------
N8N_BASE=https://your-n8n-host
N8N_ORDER_STATUS_WEBHOOK=https://your-n8n-host/webhook/order-status
NOTIFICATION_WEBHOOK_URL=https://your-n8n-host/webhook/notification
COLLECTION_WEBHOOK_URL=https://your-n8n-host/webhook/collection
DELIVERY_WEBHOOK_URL=https://your-n8n-host/webhook/delivery
OUT_FOR_DELIVERY_WEBHOOK_URL=https://your-n8n-host/webhook/out-for-delivery
CONTACT_INTAKE_WEBHOOK=https://your-n8n-host/webhook/contact-intake
REVIEWS_INTAKE_WEBHOOK=https://your-n8n-host/webhook/reviews-intake
REVIEWS_APPROVE_WEBHOOK=https://your-n8n-host/webhook/reviews-approve
REVIEWS_REJECT_WEBHOOK=https://your-n8n-host/webhook/reviews-reject
FLOW_A_PRODUCTS_INTAKE=https://your-n8n-host/webhook/products-intake
FLOW_C_BUNDLES_INTAKE=https://your-n8n-host/webhook/bundles-intake
FLOW_D_BUNDLES_PREVIEW=https://your-n8n-host/webhook/bundles-preview
CONTACT_NOTIFY_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# GitHub (product/bundle content sync to the storefront repository)
# ---------------------------------------------------------------------------
GITHUB_TOKEN=your-fine-grained-github-token
GITHUB_REPO_OWNER=your-github-org
GITHUB_REPO_NAME=your-storefront-repo
GITHUB_DEFAULT_BRANCH=main

# ---------------------------------------------------------------------------
# Site URLs (Netlify sets URL automatically in deploys)
# ---------------------------------------------------------------------------
SITE_URL=http://localhost:5173
SITE_BASE_URL=http://localhost:5173
PUBLIC_SITE_URL=https://your-store.example

# ---------------------------------------------------------------------------
# Maintenance scripts in scripts/ only
# ---------------------------------------------------------------------------
SUPABASE_KEY=your-supabase-service-role-key
